# Скопируйте в .env и заполните. Файл .env не коммитится.

# ===== Telegram =====
# Токен бота: в Telegram откройте @BotFather → /newbot → скопируйте токен
TELEGRAM_BOT_TOKEN=
# Чат администраторов, куда бот передаёт вопросы и заявки.
# Создайте группу, добавьте туда бота, напишите в группе /start,
# откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите chat.id (начинается с -100)
ADMIN_CHAT_ID=
# Telegram ID тестировщиков через запятую (узнать свой ID: @userinfobot).
# Пусто — бот доступен всем.
ALLOWED_USER_IDS=
# Обращений к администратору на пользователя в сутки (защита от спама). Для ручного
# прогона docs/manual_test.md поставьте 10.
HANDOFF_DAILY_LIMIT=3

# ===== DeepSeek =====
# Ключ: platform.deepseek.com → API keys (на счёте должен быть баланс)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Имя модели сверьте с документацией DeepSeek на момент запуска
DEEPSEEK_MODEL=deepseek-chat
# Сколько секунд ждать ответа DeepSeek; дольше — бот показывает кнопки
LLM_TIMEOUT_SECONDS=10
# Первая попытка — не дольше этого; после таймаута, сетевой ошибки, 429 или 5xx бот
# повторяет запрос один раз в оставшееся время (всего не дольше LLM_TIMEOUT_SECONDS).
LLM_FIRST_ATTEMPT_SECONDS=6
# Ответы на вопросы показываются черновиком по мере генерации (Telegram sendMessageDraft).
# false — только «печатает…».
STREAM_ANSWERS=true

# ===== Вид в Telegram =====
# Карточка записи как rich message (Bot API 10.x). Если у тестировщиков старые версии
# Telegram и карточка не открывается — поставьте false: будет обычный текст.
RICH_MESSAGES=true
# Учёт токенов по каждому вызову (без текстов) — для расчёта стоимости
LLM_USAGE_LOG=data/llm_usage.jsonl

# ===== Расписание =====
# mock — data/schedule.csv; medialog — когда клиника даст доступ
SCHEDULE_PROVIDER=mock
MEDIALOG_API_URL=
MEDIALOG_API_KEY=

# ===== Общее =====
TIMEZONE=Asia/Yekaterinburg
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
DEMO_MODE=true
LOG_LEVEL=INFO
